PORT=5000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=securebyte
DATABASE_USER=securebyte_user
# Supply your own password. Never commit the populated .env file.
DATABASE_PASSWORD=

NODE_ENV=development

# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Supplementary authentication source-rate controls
AUTH_SOURCE_LIMIT=20
AUTH_SOURCE_WINDOW_SECONDS=60

# Session cookies are Secure (HTTPS only) by default.
# Set to false ONLY for local development over plain HTTP.
COOKIE_SECURE=true
