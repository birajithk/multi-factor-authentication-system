# Docker Compose: copy to .env and populate both blank values locally.
DATABASE_NAME=securebyte
DATABASE_USER=securebyte_user
DATABASE_PASSWORD=
# A persistent 32-byte key encoded as 64 hex characters: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Local HTTP only. Use true with HTTPS in a real hosting environment.
COOKIE_SECURE=false
# Published on 127.0.0.1 only; database and backend are internal services.
FRONTEND_PORT=8080
AUTH_SOURCE_LIMIT=20
AUTH_SOURCE_WINDOW_SECONDS=60
